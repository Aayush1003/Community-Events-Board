generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("USER")
  createdAt    DateTime       @default(now())
  favourites   UserFavourite[]
  reminders    Reminder[]
  cardDesigns  CardDesign[]
}

model Event {
  id          String       @id @default(cuid())
  title       String
  category    String
  city        String
  dateTime    DateTime
  price       Float
  description String
  imageUrl    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  reminders   Reminder[]
  cardDesigns CardDesign[]

  @@index([isActive, dateTime])
  @@index([category, city])
}

model UserFavourite {
  id        String   @id @default(cuid())
  userId    String
  category  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model CardDesign {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  theme     String
  stickers  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}
